# Names used by the Node server. No live credentials belong here.
# On this laptop, load the encrypted set using scripts/Load-Inkbox.ps1.
INKBOX_API_KEY=
INKBOX_BASE_URL=https://inkbox.ai
INKBOX_AGENT_HANDLE=your-helmet-agent
INKBOX_AGENT_ID=
INKBOX_CONVERSATION_ID=
# Generated locally by the tunnel launcher; keep the complete connection URL private.
HELMET_MCP_ACCESS_TOKEN=
INKBOX_EMAIL_ADDRESS=your-helmet-agent@inkboxmail.com
INKBOX_MESSAGING_CHANNEL=shared_imessage
# The shared router is discovered through the API; it is not an owned number.
INKBOX_ROUTER_NUMBER=
INKBOX_CONNECT_COMMAND=connect @your-helmet-agent
# Leave blank until a dedicated number is actually provisioned.
INKBOX_PHONE_NUMBER=
# Leave blank until the intended trainer/demo recipient is chosen and opts in.
INKBOX_TRAINER_PHONE=
# Automatic empty-helmet demonstration: off / dry_run / live. Default is off.
# Store the model key with tools/Set-HelmetAgent.ps1, never here.
HELMET_ALERT_MODE=off
HELMET_ALERT_HELMET_ID=helmet-1
HELMET_ALERT_PLAYER="#44"
# Configurable DEMO review settings, not injury thresholds.
HELMET_ALERT_SINGLE_G=40
HELMET_ALERT_CLUSTER_COUNT=3
HELMET_ALERT_CLUSTER_SECONDS=90
HELMET_ALERT_CLUSTER_MIN_G=10
HELMET_ALERT_CLUSTER_COOLDOWN_SECONDS=300
