{
  "name": "helmet-agent-server",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "1.0.0",
  "description": "Relative helmet-impact telemetry receiver and MCP tools",
  "author": "mcp-use",
  "license": "MIT",
  "homepage": "https://github.com/mcp-use/mcp-use",
  "keywords": [
    "mcp",
    "mcp-server",
    "chatgpt plugins",
    "claude connector",
    "mcp-app",
    "mcp-use",
    "manufact"
  ],
  "scripts": {
    "build": "tsc --noEmit && mcp-use build --with-inspector --inline --no-typecheck",
    "dev": "mcp-use dev",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:demo": "tsx scripts/Check-Demo.ts"
  },
  "dependencies": {
    "@inkbox/sdk": "0.7.19",
    "@mcp-use/tunnel": "0.2.2",
    "better-sqlite3": "13.0.3",
    "mcp-use": "1.34.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@hono/node-server": "1.19.17",
    "hono": "4.13.13",
    "posthog-js": "1.438.12"
  }
}
